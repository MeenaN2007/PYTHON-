import re

def normalise(reg):
    """Remove spaces and hyphens and convert to uppercase."""
    return reg.replace(" ", "").replace("-", "").upper()


def is_valid(reg):
    """Valid format: 2 letters, 2 digits, 1 or 2 letters, 4 digits."""
    if len(reg) not in (9, 10):
        return False

    return (
        reg[:2].isalpha()
        and reg[2:4].isdigit()
        and reg[4:-4].isalpha()
        and reg[-4:].isdigit()
    )


def format_reg(reg):
    """Format registration number with spaces."""
    return " ".join([reg[:2], reg[2:4], reg[4:-4], reg[-4:]])


for raw in [
    "tn 09 ab 1234",
    "KA-01-M-0007",
    "TN9AB1234",
    "TN 22 1234 AB"
]:
    reg = normalise(raw)
    print(f"{raw:15} -> {reg:11} {'valid' if is_valid(reg) else 'INVALID'}")


print("\n--- six designed inputs ---")

for raw in [
    "tn 09 ab 1234",
    "KA-01-M-0007",
    "Tn09Ab1234",
    "ap-31-z-9999",
    "TN09ABC1234",
    "TN 09 A1 1234"
]:
    reg = normalise(raw)

    if is_valid(reg):
        print(f"{raw:15} -> {format_reg(reg)}")
    else:
        print(f"{raw:15} -> {reg} INVALID")


print("\n--- inquiry: immutability and slicing ---")

s = "tn09ab1234"

print("s.upper():", s.upper(), "| s unchanged:", s)

try:
    s[0] = "T"
except TypeError as err:
    print("TypeError:", err)


for t in ("TN09A1234", "TN09AB1234"):
    print(
        f"{t} (len {len(t)}): "
        f"s[-4:]={t[-4:]!r}  s[4:-4]={t[4:-4]!r}"
    )


# Alternative: regular expression

def is_valid_re(reg):
    return re.fullmatch(
        r"[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}",
        reg
    ) is not None


cases = [
    normalise(x)
    for x in [
        "tn 09 ab 1234",
        "KA-01-M-0007",
        "TN9AB1234",
        "TN 22 1234 AB",
        "TN09ABC1234",
        "TN 09 A1 1234"
    ]
]

print(
    "\nregex agrees with slicing:",
    all(is_valid(c) == is_valid_re(c) for c in cases)
)
